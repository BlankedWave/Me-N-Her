rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /couples/{code} {
      // New invitation codes have eight high-entropy, unambiguous characters.
      // Existing six-character spaces remain readable and updatable.
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly([
          'memberIds', 'createdBy', 'state', 'updatedAt'
        ])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.state is map;

      // No collection-wide access; only members can read a particular space.
      allow get, list: if signedIn()
        && resource.data.memberIds is list
        && request.auth.uid in resource.data.memberIds;

      allow update: if signedIn() && (
        // Members can update shared content but cannot alter membership,
        // ownership, or arbitrary metadata.
        (
          resource.data.memberIds is list
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.state is map
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['state', 'updatedAt'])
        )
        ||
        // A partner with the private code can ONLY append their own UID.
        // The original member MUST remain memberIds[0].
        (
          resource.data.memberIds is list
          && resource.data.memberIds.size() == 1
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == 2
          && request.resource.data.memberIds[0] == resource.data.memberIds[0]
          && request.resource.data.memberIds[1] == request.auth.uid
          && request.auth.uid != resource.data.memberIds[0]
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds'])
        )
      );

      // Explicit data-deletion flow and retention policy required first.
      allow delete: if false;
    }
  }
}
