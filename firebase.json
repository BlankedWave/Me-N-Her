{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.md", "**/.*", "**/node_modules/**"],
    "headers": [{
      "source": "**/*.@(js|css|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
    }]
  },
  "firestore": { "rules": "firestore.rules" }
}
